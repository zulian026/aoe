{
  "name": "@aoe/renderer",
  "version": "0.1.0",
  "type": "module",
  "description": "Terminal rendering engine and screen orchestrator for AOE",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aoe-dev/aoe.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/aoe-dev/aoe#readme",
  "bugs": "https://github.com/aoe-dev/aoe/issues",
  "keywords": [
    "aoe",
    "renderer",
    "terminal",
    "ink",
    "tty"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aoe/components": "workspace:*",
    "@aoe/core": "workspace:*",
    "@aoe/protocol": "workspace:*",
    "@aoe/themes": "workspace:*",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0"
  }
}
