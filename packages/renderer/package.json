{
  "name": "@aoe/renderer",
  "version": "0.1.0",
  "type": "module",
  "description": "Terminal rendering engine and screen orchestrator for AOE",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
