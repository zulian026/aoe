    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aoe/components": "workspace:*",
    "@aoe/core": "workspace:*",
    "@aoe/protocol": "workspace:*",
    "@aoe/themes": "workspace:*",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0"
  }
}
