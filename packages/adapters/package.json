{
  "name": "@aoe/adapters",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent ingestion adapters converting CLI/agent telemetry to AOE Universal Protocol",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aoe-dev/aoe.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://github.com/aoe-dev/aoe#readme",
  "bugs": "https://github.com/aoe-dev/aoe/issues",
  "keywords": [
    "aoe",
    "adapters",
    "claude-code",
    "gemini-cli",
    "telemetry",
    "jsonl"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aoe/protocol": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@aoe/core": "workspace:*",
    "@aoe/renderer": "workspace:*"
  }
}
