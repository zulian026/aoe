{
  "name": "@aoe/adapters",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent ingestion adapters converting CLI/agent telemetry to AOE Universal Protocol",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
