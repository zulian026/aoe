{
  "name": "@zyanx04/cli",
  "version": "0.1.2",
  "type": "module",
  "description": "Command-line interface for the AOE presentation engine",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zulian026/aoe.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/zulian026/aoe#readme",
  "bugs": "https://github.com/zulian026/aoe/issues",
  "keywords": [
    "aoe",
    "cli",
    "ai-agent",
    "terminal",
    "output-enhancement",
    "developer-tools",
    "ink"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "aoe": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && node -e \"const fs = require('fs'); fs.cpSync('../../skills', './skills', { recursive: true }); fs.copyFileSync('../../LICENSE', './LICENSE');\"",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('skills', { recursive: true, force: true }); fs.rmSync('tsconfig.tsbuildinfo', { force: true });\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "yoga-layout": "^3.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@zyanx04/adapters": "workspace:*",
    "@zyanx04/components": "workspace:*",
    "@zyanx04/core": "workspace:*",
    "@zyanx04/protocol": "workspace:*",
    "@zyanx04/renderer": "workspace:*",
    "@zyanx04/themes": "workspace:*"
  }
}
